# Copy to .env for local development. On Vercel, set these in the
# project's Environment Variables settings instead — do not commit a real
# .env file.

# Any long random string (used to sign the admin session cookie).
SECRET_KEY=change-me-to-a-long-random-string

# Postgres connection string.
#   - Neon (production, and optionally local dev too): the connection
#     string from your Neon project dashboard.
#   - A local Postgres install: postgres://user:password@localhost:5432/portfolio
DATABASE_URL=

# Set to `pg` to use a plain Postgres connection (works against local
# Postgres or Neon) instead of Neon's HTTP driver. Leave unset on Vercel —
# Neon's HTTP driver is the fast path there. Handy for local dev without
# needing a Neon project at all.
DB_DRIVER=pg

# Admin login credentials (used by /admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Comma-separated list of extra origins allowed to call /api/* from a
# browser, on top of the GitHub Pages frontend + localhost dev defaults
# already baked into src/app.js.
CORS_ALLOWED_ORIGINS=
